# Database (local dev uses SQLite; production requires a persistent Postgres — see README)
DATABASE_URL=file:./db/custom.db

# Auth secret — set to a long random string in production (e.g. `openssl rand -hex 32`)
AUTH_SECRET=change-me-to-a-long-random-string

# AI provider (optional — app runs in mock mode when AI_API_KEY is empty)
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
ENABLE_MOCK_AI=true
