# Public site URL (no trailing slash). Used for sitemap, canonical URLs,
# Open Graph tags, robots. Swap to your custom domain when you add one.
# Example: https://segalinstitute.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database — Supabase Postgres (production) or SQLite (local dev)
# Local dev (SQLite): DATABASE_URL=file:./db/custom.db
# Production (Supabase Postgres pooled via Supavisor — for serverless):
#   DATABASE_URL=postgresql://postgres.{ref}:{password}@aws-0-{region}.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Production (Supabase Postgres session-mode pooler — for migrations/seed):
#   DIRECT_URL=postgresql://postgres.{ref}:{password}@aws-0-{region}.pooler.supabase.com:5432/postgres
DATABASE_URL=file:./db/custom.db
DIRECT_URL=

# Auth secret — set to a long random string in production (e.g. `openssl rand -hex 32`)
AUTH_SECRET=change-me-to-a-long-random-string

# AI provider (optional — app runs in mock mode when AI_API_KEY is empty)
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_VISION_MODEL=
ENABLE_MOCK_AI=true
