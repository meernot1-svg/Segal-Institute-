// Prisma schema — English Academy
// SQLite provider. Enums are emulated with String fields + app-level validation
// (Prisma enums are not natively supported on SQLite).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Auth & profiles
// ---------------------------------------------------------------------------

model Profile {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  // "student" | "admin"
  role         String   @default("student")
  classGrade   String?
  avatarUrl    String?
  // Tiered membership: "pending" | "active" | "rejected"
  status       String   @default("active")
  // Badge tier: "basic" | "junior" | "senior" | "elite_senior"
  badge        String   @default("basic")
  approvedBy   String?
  approvedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  verbProgress     StudentVerbProgress[]
  favorites        Favorite[]
  goals            Goal[]
  testAttempts     TestAttempt[]
  achievements     StudentAchievement[]
  chatConversations ChatConversation[]
  generatedSpeeches GeneratedSpeech[]
  generatedPoetry   GeneratedPoem[]
  generatedSentences GeneratedSentence[]
  fees             Fee[]
  dailyTopics      DailyTopic[]
  monthlyResults   MonthlyResult[]
  studentSpeeches  StudentSpeech[] @relation("StudentSpeechAuthor")
  attendance       Attendance[]
  badgeHistory     BadgeHistory[]   @relation("BadgeHistoryUser")
  badgeChanges     BadgeHistory[]   @relation("BadgeHistoryAdmin")
  calendarEvents   CalendarEvent[]
}

// ---------------------------------------------------------------------------
// Badge promotion history
// ---------------------------------------------------------------------------

model BadgeHistory {
  id         String   @id @default(cuid())
  userId     String
  // null on first assignment (pending → approved)
  oldBadge   String?
  newBadge   String
  changedBy  String
  changedAt  DateTime @default(now())

  user   Profile  @relation("BadgeHistoryUser", fields: [userId], references: [id], onDelete: Cascade)
  admin  Profile  @relation("BadgeHistoryAdmin", fields: [changedBy], references: [id], onDelete: SetNull)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Verbs
// ---------------------------------------------------------------------------

model Verb {
  id        String   @id @default(cuid())
  v1        String
  v2        String
  v3        String
  // JSON-encoded string arrays of accepted alternate spellings, e.g. '["dreamt"]'
  v2Alts    String   @default("[]")
  v3Alts    String   @default("[]")
  meaning   String
  // "en" | "sd" (Sindhi) | ...
  meaningLanguage String @default("en")
  // "pdf" | "regular-pattern" | "dataset" | "seed" | "tier-import"
  source    String   @default("seed")
  sourcePage Int?
  // "high" | "medium" | "low"
  confidence String  @default("high")
  needsReview Boolean @default(false)
  // 1 = easy, 2 = medium, 3 = hard
  difficulty Int     @default(1)
  // Tiered membership: minimum badge required to access this verb
  // "basic" | "junior" | "senior" | "elite_senior"
  minTier   String   @default("basic")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  progress   StudentVerbProgress[]
  favorites  Favorite[]
  testAnswers TestAnswer[]

  @@index([v1])
  @@index([source])
  @@index([needsReview])
  @@index([minTier])
}

// ---------------------------------------------------------------------------
// Content items — vocabulary words, lessons, etc. (non-verb content for
// tiered access: senior-tier Urdu vocabulary, future lessons, etc.)
// ---------------------------------------------------------------------------

model ContentItem {
  id          String   @id @default(cuid())
  // "vocab" | "lesson" | "plural_rule" | etc.
  type        String   @default("vocab")
  // The word, title, or key
  word        String
  // English meaning / description
  meaning     String
  // Urdu meaning (if available)
  meaningUr   String?
  // Extra context / example sentence
  example     String?
  // Minimum badge tier to access this content
  // "basic" | "junior" | "senior" | "elite_senior"
  minTier     String   @default("basic")
  // Source tag
  source      String   @default("tier-import")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([minTier])
  @@index([type])
  @@index([word])
}

model StudentVerbProgress {
  id              String   @id @default(cuid())
  profileId       String
  verbId          String
  // "new" | "learning" | "learned" | "difficult"
  status          String   @default("new")
  mastery         Int      @default(0) // 0..5
  timesReviewed   Int      @default(0)
  lastReviewedAt  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  verb    Verb    @relation(fields: [verbId], references: [id], onDelete: Cascade)

  @@unique([profileId, verbId])
  @@index([profileId])
  @@index([verbId])
  @@index([status])
}

model Favorite {
  id        String   @id @default(cuid())
  profileId String
  verbId    String
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  verb    Verb    @relation(fields: [verbId], references: [id], onDelete: Cascade)

  @@unique([profileId, verbId])
  @@index([profileId])
}

// ---------------------------------------------------------------------------
// Goals, streaks, achievements
// ---------------------------------------------------------------------------

model Goal {
  id        String   @id @default(cuid())
  profileId String
  // "daily_verbs" | "weekly_verbs" | "test_score" | "streak_days"
  type      String
  target    Int
  // "verbs" | "percent" | "days"
  unit      String   @default("verbs")
  // ISO date string (yyyy-mm-dd) for the period this goal applies to
  periodKey String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Achievement {
  id          String   @id @default(cuid())
  // "first_step" | "verb_starter" | ...
  code        String   @unique
  title       String
  description String
  icon        String?
  createdAt   DateTime @default(now())

  studentAchievements StudentAchievement[]
}

model StudentAchievement {
  id           String   @id @default(cuid())
  profileId    String
  achievementId String
  earnedAt     DateTime @default(now())

  profile     Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([profileId, achievementId])
  @@index([profileId])
}

// ---------------------------------------------------------------------------
// Tests
// ---------------------------------------------------------------------------

model TestAttempt {
  id          String   @id @default(cuid())
  profileId   String
  // "MCQ" | "WRITTEN"
  type        String
  // "v1-to-v2" | "v1-to-v3" | "v2-to-v3" | "meaning" | "mixed" | "random"
  // for written: "v1-to-v2v3" | "v2-to-v1v3" | "v3-to-v1v2" | "mixed"
  category    String
  length      Int
  correct     Int      @default(0)
  total       Int      @default(0)
  percentage  Float    @default(0)
  timeSpentSec Int     @default(0)
  startedAt   DateTime @default(now())
  completedAt DateTime @default(now())

  profile Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  answers  TestAnswer[]

  @@index([profileId])
  @@index([completedAt])
}

model TestAnswer {
  id           String  @id @default(cuid())
  attemptId    String
  verbId       String?
  // "v1-to-v2" | "v1-to-v3" | "v2-to-v3" | "meaning" | "written-v1-to-v2v3" ...
  questionType String
  prompt       String
  userAnswer   String
  correctAnswer String
  isCorrect    Boolean @default(false)
  // JSON array of options for MCQ, null for written
  optionsJson  String?

  attempt TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  verb    Verb?       @relation(fields: [verbId], references: [id], onDelete: SetNull)

  @@index([attemptId])
}

// Admin-authored question bank (Phase 4). Not used in Phase 1 MCQ generation.
model Question {
  id        String   @id @default(cuid())
  // "MCQ" | "WRITTEN"
  type      String
  category  String
  prompt    String
  // JSON array of options (MCQ) or accepted answers (written)
  optionsJson String?
  answer    String
  verbId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// AI features (Phase 3) — schema stubs now, wired later
// ---------------------------------------------------------------------------

model ChatConversation {
  id        String   @id @default(cuid())
  profileId String
  title     String   @default("New chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile  Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([profileId])
}

model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String
  // "user" | "assistant"
  role           String
  content        String
  createdAt       DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model GeneratedSpeech {
  id        String   @id @default(cuid())
  profileId String
  topic     String
  language  String
  duration  String
  level     String
  audience  String
  style     String
  tone      String
  content   String
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model GeneratedPoem {
  id        String   @id @default(cuid())
  profileId String
  topic     String
  language  String
  style     String
  length    String
  mood      String
  content   String
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

// ---------------------------------------------------------------------------
// Sentence Generator (AI) — original, user-saved sentences on any topic
// in any language. Each row is one saved generation containing N sentences
// (the count is part of the request, not stored separately).
// ---------------------------------------------------------------------------

model GeneratedSentence {
  id        String   @id @default(cuid())
  profileId String
  // The user-provided topic / theme (free text)
  topic     String
  // Output language for the generated sentences
  language  String
  // Sentence type: "Simple" | "Compound" | "Complex" | "Mixed" | "Question" | "Affirmative" | "Negative" | "Imperative"
  sentenceType String
  // Proficiency level: "Beginner" | "Intermediate" | "Advanced"
  level     String
  // Number of sentences the user asked for (kept as string for legacy compat)
  count     String
  // Optional mood/tone/style hint the user provided
  tone      String
  // The generated sentences (one per line, in the requested language)
  content   String
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

// ---------------------------------------------------------------------------
// Announcements & daily topics (admin)
// ---------------------------------------------------------------------------

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  // "info" | "success" | "warning"
  severity  String   @default("info")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DailyTopic {
  id          String   @id @default(cuid())
  title       String
  body        String
  // ISO date string (yyyy-mm-dd) — the day this topic is "today's topic"
  date       String
  authorId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author      Profile? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([date])
  @@index([date])
}

// ---------------------------------------------------------------------------
// Fees (admin-assigned, student-visible)
// ---------------------------------------------------------------------------

model Fee {
  id         String   @id @default(cuid())
  studentId  String
  amount     Float
  // "monthly" | "one-time" | "quarterly"
  kind       String   @default("monthly")
  // ISO date string (yyyy-mm-dd) — the billing period this fee covers
  periodKey  String
  dueDate    DateTime
  paid       Boolean  @default(false)
  paidAt     DateTime?
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  student Profile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, periodKey])
  @@index([studentId])
  @@index([periodKey])
}

// ---------------------------------------------------------------------------
// Student speeches (admin writes for a student; all students can view)
// ---------------------------------------------------------------------------

model StudentSpeech {
  id          String   @id @default(cuid())
  title       String
  // Short description shown under the title (admin writes this)
  description String   @default("")
  studentName String
  // Optional link to a profile (in case admin wants to attach to a real student)
  studentId   String?
  // For text speeches/poems/essays: the written content
  content     String   @default("")
  // For video speeches: a YouTube/embed URL OR a direct video file URL
  videoUrl    String?
  // For uploaded video files: base64 data URL (small files only — see note below)
  videoData   String?
  // "speech" | "poem" | "essay" | "video" — kind of work
  kind        String   @default("speech")
  authorId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author  Profile? @relation("StudentSpeechAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([studentName])
}

// ---------------------------------------------------------------------------
// Monthly results (admin writes notes OR uploads a result-card image -> AI
// generates a polished, personalized result card per student)
// ---------------------------------------------------------------------------

model MonthlyResult {
  id            String   @id @default(cuid())
  studentId     String
  periodKey     String
  // Admin's raw text notes (input, text mode)
  notes         String   @default("")
  // Admin's uploaded result-card image (input, image mode) — base64 data URL
  imageUrl      String?
  // AI-extracted text from the uploaded image (from vision model)
  extractedText String   @default("")
  // AI-generated polished result card (output, personalized per student)
  generatedCard String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student Profile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, periodKey])
  @@index([studentId])
  @@index([periodKey])
}

// ---------------------------------------------------------------------------
// Shared monthly result image (admin uploads ONE image per month; ALL
// students see the same image on their /monthly-results page — no AI)
// ---------------------------------------------------------------------------

model MonthlyResultImage {
  id        String   @id @default(cuid())
  title     String
  // YYYY-MM — the month this result image is for (one image per month)
  month     String   @unique
  // Base64 data URL of the uploaded image
  imageUrl  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([month])
}

// ---------------------------------------------------------------------------
// Best Student of the Month (admin uploads name + photo; student dashboard)
// ---------------------------------------------------------------------------

model BestStudent {
  id        String   @id @default(cuid())
  name      String
  // Base64 data URL photo (resized client-side)
  photo     String
  // YYYY-MM
  month     String
  blurb     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([month])
  @@index([active])
}

// ---------------------------------------------------------------------------
// Attendance (admin marks students present/absent per day)
// ---------------------------------------------------------------------------

model Attendance {
  id        String   @id @default(cuid())
  studentId String
  // ISO date string (yyyy-mm-dd) — the day this attendance is for
  date      String
  present   Boolean  @default(false)
  markedBy  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Profile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([studentId])
  @@index([date])
}

// ---------------------------------------------------------------------------
// Calendar events (admin creates; students see on the dashboard calendar).
// Upcoming events are tagged + animated on the student dashboard.
// ---------------------------------------------------------------------------

model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  // ISO date string (yyyy-mm-dd) — the day this event is on
  date        String
  // Optional time string (e.g. "10:00") shown next to the date
  time        String?
  // Optional location / venue text
  location    String?
  // Color tag — used by the dashboard calendar to color the dot
  // "emerald" | "navy" | "gold" | "rose" | "violet"
  color       String   @default("emerald")
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author  Profile? @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([date])
}

// ---------------------------------------------------------------------------
// Homepage content (admin-managed). Key-value store so any field on the
// public homepage can be edited without migrations. Image values are stored
// as data URLs (small images only — admin uploads are resized client-side).
// ---------------------------------------------------------------------------

model HomeContent {
  id        String   @id @default(cuid())
  // Unique key: "hero_title", "hero_subtitle", "hero_image", "section1_title",
  // "section1_body", "section1_image", "cta_title", "cta_body", etc.
  key       String   @unique
  // The value: text for text fields, data URL for image fields.
  value     String
  // "text" | "image" — used by the admin editor to render the right input
  kind      String   @default("text")
  // Optional human-readable label shown in the admin editor (e.g. "Hero title")
  label     String?
  updatedAt DateTime @updatedAt
}

