// Prisma schema — English Academy
// SQLite provider. Enums are emulated with String fields + app-level validation
// (Prisma enums are not natively supported on SQLite).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Auth & profiles
// ---------------------------------------------------------------------------

model Profile {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  // "student" | "admin"
  role         String   @default("student")
  classGrade   String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  verbProgress     StudentVerbProgress[]
  favorites        Favorite[]
  goals            Goal[]
  testAttempts     TestAttempt[]
  achievements     StudentAchievement[]
  chatConversations ChatConversation[]
  generatedSpeeches GeneratedSpeech[]
  generatedPoetry   GeneratedPoem[]
  fees             Fee[]
  dailyTopics      DailyTopic[]
}

// ---------------------------------------------------------------------------
// Verbs
// ---------------------------------------------------------------------------

model Verb {
  id        String   @id @default(cuid())
  v1        String
  v2        String
  v3        String
  // JSON-encoded string arrays of accepted alternate spellings, e.g. '["dreamt"]'
  v2Alts    String   @default("[]")
  v3Alts    String   @default("[]")
  meaning   String
  // "en" | "sd" (Sindhi) | ...
  meaningLanguage String @default("en")
  // "pdf" | "regular-pattern" | "dataset" | "seed"
  source    String   @default("seed")
  sourcePage Int?
  // "high" | "medium" | "low"
  confidence String  @default("high")
  needsReview Boolean @default(false)
  // 1 = easy, 2 = medium, 3 = hard
  difficulty Int     @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  progress   StudentVerbProgress[]
  favorites  Favorite[]
  testAnswers TestAnswer[]

  @@index([v1])
  @@index([source])
  @@index([needsReview])
}

model StudentVerbProgress {
  id              String   @id @default(cuid())
  profileId       String
  verbId          String
  // "new" | "learning" | "learned" | "difficult"
  status          String   @default("new")
  mastery         Int      @default(0) // 0..5
  timesReviewed   Int      @default(0)
  lastReviewedAt  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  verb    Verb    @relation(fields: [verbId], references: [id], onDelete: Cascade)

  @@unique([profileId, verbId])
  @@index([profileId])
  @@index([verbId])
  @@index([status])
}

model Favorite {
  id        String   @id @default(cuid())
  profileId String
  verbId    String
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  verb    Verb    @relation(fields: [verbId], references: [id], onDelete: Cascade)

  @@unique([profileId, verbId])
  @@index([profileId])
}

// ---------------------------------------------------------------------------
// Goals, streaks, achievements
// ---------------------------------------------------------------------------

model Goal {
  id        String   @id @default(cuid())
  profileId String
  // "daily_verbs" | "weekly_verbs" | "test_score" | "streak_days"
  type      String
  target    Int
  // "verbs" | "percent" | "days"
  unit      String   @default("verbs")
  // ISO date string (yyyy-mm-dd) for the period this goal applies to
  periodKey String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Achievement {
  id          String   @id @default(cuid())
  // "first_step" | "verb_starter" | ...
  code        String   @unique
  title       String
  description String
  icon        String?
  createdAt   DateTime @default(now())

  studentAchievements StudentAchievement[]
}

model StudentAchievement {
  id           String   @id @default(cuid())
  profileId    String
  achievementId String
  earnedAt     DateTime @default(now())

  profile     Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([profileId, achievementId])
  @@index([profileId])
}

// ---------------------------------------------------------------------------
// Tests
// ---------------------------------------------------------------------------

model TestAttempt {
  id          String   @id @default(cuid())
  profileId   String
  // "MCQ" | "WRITTEN"
  type        String
  // "v1-to-v2" | "v1-to-v3" | "v2-to-v3" | "meaning" | "mixed" | "random"
  // for written: "v1-to-v2v3" | "v2-to-v1v3" | "v3-to-v1v2" | "mixed"
  category    String
  length      Int
  correct     Int      @default(0)
  total       Int      @default(0)
  percentage  Float    @default(0)
  timeSpentSec Int     @default(0)
  startedAt   DateTime @default(now())
  completedAt DateTime @default(now())

  profile Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  answers  TestAnswer[]

  @@index([profileId])
  @@index([completedAt])
}

model TestAnswer {
  id           String  @id @default(cuid())
  attemptId    String
  verbId       String?
  // "v1-to-v2" | "v1-to-v3" | "v2-to-v3" | "meaning" | "written-v1-to-v2v3" ...
  questionType String
  prompt       String
  userAnswer   String
  correctAnswer String
  isCorrect    Boolean @default(false)
  // JSON array of options for MCQ, null for written
  optionsJson  String?

  attempt TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  verb    Verb?       @relation(fields: [verbId], references: [id], onDelete: SetNull)

  @@index([attemptId])
}

// Admin-authored question bank (Phase 4). Not used in Phase 1 MCQ generation.
model Question {
  id        String   @id @default(cuid())
  // "MCQ" | "WRITTEN"
  type      String
  category  String
  prompt    String
  // JSON array of options (MCQ) or accepted answers (written)
  optionsJson String?
  answer    String
  verbId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// AI features (Phase 3) — schema stubs now, wired later
// ---------------------------------------------------------------------------

model ChatConversation {
  id        String   @id @default(cuid())
  profileId String
  title     String   @default("New chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile  Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([profileId])
}

model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String
  // "user" | "assistant"
  role           String
  content        String
  createdAt       DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model GeneratedSpeech {
  id        String   @id @default(cuid())
  profileId String
  topic     String
  language  String
  duration  String
  level     String
  audience  String
  style     String
  tone      String
  content   String
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model GeneratedPoem {
  id        String   @id @default(cuid())
  profileId String
  topic     String
  language  String
  style     String
  length    String
  mood      String
  content   String
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

// ---------------------------------------------------------------------------
// Announcements & daily topics (admin)
// ---------------------------------------------------------------------------

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  // "info" | "success" | "warning"
  severity  String   @default("info")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DailyTopic {
  id          String   @id @default(cuid())
  title       String
  body        String
  // ISO date string (yyyy-mm-dd) — the day this topic is "today's topic"
  date       String
  authorId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author      Profile? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([date])
  @@index([date])
}

// ---------------------------------------------------------------------------
// Fees (admin-assigned, student-visible)
// ---------------------------------------------------------------------------

model Fee {
  id         String   @id @default(cuid())
  studentId  String
  amount     Float
  // "monthly" | "one-time" | "quarterly"
  kind       String   @default("monthly")
  // ISO date string (yyyy-mm-dd) — the billing period this fee covers
  periodKey  String
  dueDate    DateTime
  paid       Boolean  @default(false)
  paidAt     DateTime?
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  student Profile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, periodKey])
  @@index([studentId])
  @@index([periodKey])
}
